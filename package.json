{
  "name": "skinkey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present && node scripts/lint-claims.mjs",
    "dev:worker": "npm run dev -w @skinkey/worker",
    "dev:web": "npm run dev -w @skinkey/web",
    "dev:mobile": "npm run start -w @skinkey/mobile",
    "gen:devvars": "node scripts/gen-dev-vars.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
