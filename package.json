{
  "name": "skinkey",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present && npm run lint:claims",
    "lint:claims": "esbuild scripts/lint-claims.ts --bundle --platform=node --format=esm --external:typescript --outfile=node_modules/.cache/skinkey/lint-claims.mjs --log-level=warning && node node_modules/.cache/skinkey/lint-claims.mjs",
    "dev:worker": "npm run dev -w @skinkey/worker",
    "dev:web": "npm run dev -w @skinkey/web",
    "dev:mobile": "npm run start -w @skinkey/mobile",
    "gen:devvars": "node scripts/gen-dev-vars.mjs",
    "audit": "node scripts/audit.mjs",
    "catalog:merge": "esbuild scripts/merge-catalog.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/skinkey/merge-catalog.mjs --log-level=warning && node node_modules/.cache/skinkey/merge-catalog.mjs && npm run build:catalog -w @skinkey/worker",
    "secrets:grep": "node scripts/secret-grep.mjs",
    "smoke:mock": "npm run smoke:mock -w @skinkey/worker",
    "emu": "bash ops/vm/emu.sh",
    "shots:web": "node scripts/shoot-mobile-web.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
